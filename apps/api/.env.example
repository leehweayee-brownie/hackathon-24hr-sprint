# --- Server
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
WEB_URL=http://localhost:8888
CORS_ORIGIN=http://localhost:8888

# --- Database (docker compose default: user vp / password vp / db vendor_passport on :5432)
DATABASE_URL=postgresql://vp:vp@localhost:5432/vendor_passport

# --- Redis (job queue, cache, realtime fan-out)
REDIS_URL=redis://localhost:6379

# --- Object storage. STORAGE_DRIVER=local writes to LOCAL_STORAGE_DIR (relative to apps/api; ./uploads is apps/api/uploads, no encryption, dev only). STORAGE_DRIVER=s3 uses MinIO or S3 with server-side encryption.
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vendor-passport
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_SSE=AES256
SIGNED_URL_TTL_SECONDS=300
LOCAL_STORAGE_DIR=./uploads

# --- Auth
JWT_SECRET=change-me-to-at-least-32-random-characters-please
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
SHARE_TOKEN_SECRET=change-me-too-at-least-32-random-characters

# --- AI. AI_PROVIDER=anthropic needs ANTHROPIC_API_KEY. AI_PROVIDER=mock replays fixtures/extractions (offline demo).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# AI_PROVIDER=odin uses GT-Odin, Gamuda's internal agent platform. Ask the Odin operators for a
# Vendor Passport service account; do not reuse another product's key. The model must support
# images and documents (check GET /v1/models).
ODIN_BASE_URL=
ODIN_API_KEY=
ODIN_MODEL=gemini-3.5-flash
ODIN_TIMEOUT_MS=180000
ODIN_PRINCIPAL_ID=system:vendor-passport
AI_MAX_PAGES=20
CONFIDENCE_THRESHOLD=0.85
EXPIRY_WARNING_DAYS=30
FIXTURES_DIR=../../fixtures

# --- Limits
MAX_FILE_SIZE_MB=25
MAX_PAGES=20
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# --- Email (dev: links are logged, not sent)
MAIL_DRIVER=log
